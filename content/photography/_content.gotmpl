{{/*
  Content adapter: one page per photo at /photography/<album>/<photo-id>/,
  generated from data/photos/<album>.json (written by `npm run photos`).
  These pages are for direct links and sharing; the album page itself renders the grid from the same data.
*/}}
{{ range $album, $data := .Site.Data.photos }}
  {{ range $i, $p := $data.photos }}
    {{/* Page title: "<place> · <album>", e.g. "Seville · Spain & Portugal" */}}
    {{ $title := $data.title }}
    {{ range $p.tags }}{{ if hasPrefix . "places|" }}{{ $parts := split . "|" }}{{ $title = printf "%s · %s" (index $parts (sub (len $parts) 1)) $data.title }}{{ end }}{{ end }}
    {{ $.AddPage (dict
      "path" (printf "%s/%s" $album $p.id)
      "kind" "page"
      "title" $title
      "date" $p.date
      "build" (dict "list" "never")
      "params" (dict "album" $album "photo_id" $p.id)
    ) }}
  {{ end }}
{{ end }}
